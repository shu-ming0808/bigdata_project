            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"CandidateKey\", \"EvidenceID\", \"Term\", \"CourseCode\", \"Course\", \"Language\", \"FormalEMI\", \"Teacher\"}, {",
                "        {\"DEMO101|PUBLIC-TA\", \"PUBLIC-O0001\", \"1091\", \"DEMO101\", \"資料結構基礎\", \"英語\", \"是\", \"示例教師 A\"},\n        {\"DEMO101|PUBLIC-TA\", \"PUBLIC-O0002\", \"1111\", \"DEMO101\", \"資料結構基礎\", \"英語\", \"是\", \"示例教師 A\"},\n        {\"DEMO101|PUBLIC-TA\", \"PUBLIC-O0004\", \"1122\", \"DEMO111\", \"資料結構實作\", \"英語\", \"是\", \"示例教師 A\"},\n        {\"DEMO101|PUBLIC-TA\", \"PUBLIC-O0003\", \"1141\", \"DEMO101\", \"資料結構基礎\", \"英語\", \"是\", \"示例教師 A\"},\n        {\"DEMO101|PUBLIC-TA\", \"PUBLIC-O0005\", \"1142\", \"DEMO111\", \"資料結構實作\", \"英語\", \"是\", \"示例教師 A\"},\n        {\"DEMO101|PUBLIC-TC\", \"PUBLIC-O0011\", \"1121\", \"DEMO201\", \"系統架構概論\", \"英語\", \"是\", \"示例教師 C\"},\n        {\"DEMO101|PUBLIC-TC\", \"PUBLIC-O0010\", \"1131\", \"DEMO101\", \"資料結構基礎\", \"英語\", \"是\", \"示例教師 C\"},\n        {\"DEMO101|PUBLIC-TC\", \"PUBLIC-O0012\", \"1141\", \"DEMO201\", \"系統架構概論\", \"英語\", \"是\", \"示例教師 C\"},\n        {\"DEMO101|PUBLIC-TB\", \"PUBLIC-O0006\", \"1061\", \"DEMO101\", \"資料結構基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO101|PUBLIC-TB\", \"PUBLIC-O0007\", \"1081\", \"DEMO101\", \"資料結構基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO101|PUBLIC-TB\", \"PUBLIC-O0020\", \"1092\", \"DEMO301\", \"網路通訊基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO101|PUBLIC-TB\", \"PUBLIC-O0008\", \"1101\", \"DEMO101\", \"資料結構基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO101|PUBLIC-TB\", \"PUBLIC-O0009\", \"1112\", \"DEMO111\", \"資料結構實作\", \"英語\", \"未知\", \"示例教師 B\"},\n        {\"DEMO101|PUBLIC-TB\", \"PUBLIC-O0021\", \"1112\", \"DEMO301\", \"網路通訊基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO201|PUBLIC-TC\", \"PUBLIC-O0011\", \"1121\", \"DEMO201\", \"系統架構概論\", \"英語\", \"是\", \"示例教師 C\"},\n        {\"DEMO201|PUBLIC-TC\", \"PUBLIC-O0010\", \"1131\", \"DEMO101\", \"資料結構基礎\", \"英語\", \"是\", \"示例教師 C\"},\n        {\"DEMO201|PUBLIC-TC\", \"PUBLIC-O0012\", \"1141\", \"DEMO201\", \"系統架構概論\", \"英語\", \"是\", \"示例教師 C\"},\n        {\"DEMO201|PUBLIC-TD\", \"PUBLIC-O00