教師 D\"},\n        {\"DEMO301|PUBLIC-TB\", \"PUBLIC-O0006\", \"1061\", \"DEMO101\", \"資料結構基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO301|PUBLIC-TB\", \"PUBLIC-O0007\", \"1081\", \"DEMO101\", \"資料結構基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO301|PUBLIC-TB\", \"PUBLIC-O0020\", \"1092\", \"DEMO301\", \"網路通訊基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO301|PUBLIC-TB\", \"PUBLIC-O0008\", \"1101\", \"DEMO101\", \"資料結構基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO301|PUBLIC-TB\", \"PUBLIC-O0009\", \"1112\", \"DEMO111\", \"資料結構實作\", \"英語\", \"未知\", \"示例教師 B\"},\n        {\"DEMO301|PUBLIC-TB\", \"PUBLIC-O0021\", \"1112\", \"DEMO301\", \"網路通訊基礎\", \"國語\", \"否\", \"示例教師 B\"},\n        {\"DEMO401|PUBLIC-TF\", \"PUBLIC-O0024\", \"1132\", \"DEMO401\", \"量子運算入門\", \"國語\", \"未知\", \"示例教師 F\"},\n        {\"DEMO401|PUBLIC-TF\", \"PUBLIC-O0025\", \"1151\", \"DEMO401\", \"量子運算入門\", \"國語\", \"未知\", \"示例教師 F\"}",
                "    }),",
